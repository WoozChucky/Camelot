# Test binaries and example ELFs are committed so no cross toolchain is needed.
*.elf binary
*.o binary
*.a binary
# A text member of the archive fixtures, archived byte for byte.
crates/elf/tests/archive/*.txt -text
*.img binary
*.pcap binary
tests/riscv-tests/rv* binary
# RV32 riscv-tests, which merlin-objdump still reads.
crates/merlin-objdump/tests/fixtures/rv32/* binary
tests/opensbi/*.bin binary
# The console's font as its release ships it (kernel/fonts/README.md).
*.psfu binary
*.S text eol=lf
*.sh text eol=lf
*.c text eol=lf
*.h text eol=lf
*.s text eol=lf
*.ld text eol=lf
*.ast text eol=lf
kernel/kernel.elf.clang-version text eol=lf
# Built by `cargo xtask kernel`; collapsed in GitHub diffs.
kernel/kernel.elf binary linguist-generated
kernel/kernel-disk.elf binary linguist-generated
# Generated from kernel/fonts/spleen-8x16.psfu by `cargo xtask kernel`.
kernel/font.c linguist-generated
# llvm-objdump output, compared line by line (keep LF so it diffs cleanly).
crates/merlin-objdump/tests/golden/*.txt text eol=lf
crates/merlin-as/tests/golden/*.txt text eol=lf
crates/merlin-as/tests/golden/*.ref text eol=lf
crates/merlin-as/tests/golden/*.golden text eol=lf
crates/merlin-as/tests/mapping/**/*.txt text eol=lf
# llvm-readelf and llvm-dwarfdump output for the elf crate's fixtures.
crates/elf/tests/llvm/*/*.readelf text eol=lf
crates/elf/tests/llvm/*/*.lines text eol=lf
*.inc text eol=lf
# Documents some tests read and compare against the code.
*.md text eol=lf
# The root filesystem's files are copied into disk images byte for byte:
# the same bytes on every checkout.
kernel/fs/** -text
